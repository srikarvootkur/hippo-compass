# Public domains
ASSISTANT_DOMAIN=assistant.example.com
OPENCLAW_DOMAIN=openclaw.example.com

# Runtime
ENVIRONMENT=development
LOG_LEVEL=info
ASSISTANT_API_KEY=change-me-local-dev
DATABASE_URL=postgresql://assistant:assistant@postgres:5432/assistant
REDIS_URL=redis://redis:6379/0
HIPPO_COMPASS_API_URL=http://assistant-api:8080
HIPPO_COMPASS_API_KEY=change-me-local-dev

# OpenAI / specialist agent workflows
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Workflow services
LANGGRAPH_WORKFLOWS_URL=http://langgraph-workflows:8070
AGENTS_WORKFLOWS_URL=http://agents-workflows:8090

# Local Postgres container only. Use managed Postgres in production.
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant

# OpenClaw
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_RUNTIME_IMAGE=hippo-openclaw:ghealth

# Optional integrations
TELEGRAM_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRONOMETER_API_KEY=

# Google Health via ghealth. Keep this directory outside the repo, root-owned
# and chmod 0700. It contains client_secret.json, credentials.json, config.toml.
GHEALTH_CONFIG_HOST_PATH=/opt/hippo-secrets/ghealth
GHEALTH_GIT_REF=9cf02743d9ca051500b7c1c181eb88a9ae8988a5
GHEALTH_BACKFILL_DAYS=90
GHEALTH_BACKFILL_WINDOW_DAYS=7
GHEALTH_OVERLAP_HOURS=24
GHEALTH_SYNC_INTERVAL_SECONDS=14400
